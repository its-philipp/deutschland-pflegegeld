---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon from '../components/Icon.astro';
import PflegegradBadge from '../components/PflegegradBadge.astro';
import PflegegradSkala from '../components/PflegegradSkala.astro';
import LeistungsRechner from '../components/LeistungsRechner';
import NaechsterSchritt from '../components/NaechsterSchritt.astro';
import { accentFor } from '../data/kategorien';
import { pfadVon, THEMEN } from '../data/themen';
import {
  ENTLASTUNGSBETRAG,
  GEMEINSAMER_JAHRESBETRAG,
  PFLEGEGELD,
  PFLEGEHILFSMITTEL_VERBRAUCH,
  PFLEGESACHLEISTUNG,
  SGB_XI_FASSUNG,
  SGB_XI_STAND,
  TEILSTATIONAERE_PFLEGE,
  VOLLSTATIONAER,
  VOLLSTATIONAER_GRAD_1,
  WOHNUMFELDVERBESSERUNG,
  type Leistung,
  type Pflegegrad,
} from '../data/leistungen';

/**
 * Eine Seite je Pflegegrad (queue task 2.5).
 *
 * All amounts are read from `data/leistungen.ts` — the page never writes a
 * figure of its own. That is the rule from queue task 2.3, and it is what makes
 * the annual Verordnung update a one-file change instead of a hunt.
 *
 * Pflegegrad 1 is deliberately not a thinner copy of the others: it is the page
 * where the honest answer is mostly "nein". Someone who has just been assigned
 * Grad 1 needs to know that there is no Pflegegeld and no Sachleistung before
 * they need to know anything else, so the page says it first and does not show
 * a calculator that would only ever display zero.
 */
export function getStaticPaths() {
  return ([1, 2, 3, 4, 5] as const).map((grad) => ({
    params: { grad: String(grad) },
    props: { grad },
  }));
}

interface Props {
  grad: Pflegegrad;
}

const { grad } = Astro.props;
const akzent = accentFor('pflegegrad');
const hatGeldleistung = grad >= 2;

const pflegegeld = PFLEGEGELD.betrag[grad];
const sachleistung = PFLEGESACHLEISTUNG.betrag[grad];
const tagespflege = TEILSTATIONAERE_PFLEGE.betrag[grad];
const heim = VOLLSTATIONAER.betrag[grad];

const euro = (b: number) =>
  b.toLocaleString('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const datum = (iso: string) => iso.split('-').reverse().join('.');

/** One row of the benefits table. `betrag === null` means "kein Anspruch". */
interface Zeile {
  was: string;
  betrag: number | null;
  takt: string;
  quelle: Leistung;
  hinweis?: string;
}

const zeilen: Zeile[] = [
  {
    was: 'Pflegegeld',
    betrag: pflegegeld,
    takt: 'im Monat',
    quelle: PFLEGEGELD.quelle,
    hinweis: 'Wenn Sie die Pflege selbst organisieren, etwa mit Angehörigen.',
  },
  {
    was: 'Pflegesachleistung',
    betrag: sachleistung,
    takt: 'im Monat',
    quelle: PFLEGESACHLEISTUNG.quelle,
    hinweis: 'Der Wert der Einsätze eines ambulanten Pflegedienstes.',
  },
  {
    was: 'Tages- oder Nachtpflege',
    betrag: tagespflege,
    takt: 'im Monat',
    quelle: TEILSTATIONAERE_PFLEGE.quelle,
    hinweis: 'Zusätzlich zu Pflegegeld und Sachleistung.',
  },
  {
    was: 'Verhinderungs- und Kurzzeitpflege',
    betrag: hatGeldleistung ? GEMEINSAMER_JAHRESBETRAG.betrag : null,
    takt: 'im Jahr',
    quelle: GEMEINSAMER_JAHRESBETRAG.quelle,
    hinweis:
      'Ein gemeinsamer Jahresbetrag für beides. Zwei getrennte Töpfe gibt es seit der Neuregelung nicht mehr.',
  },
  {
    was: 'Entlastungsbetrag',
    betrag: ENTLASTUNGSBETRAG.betrag,
    takt: 'im Monat',
    quelle: ENTLASTUNGSBETRAG.quelle,
    hinweis:
      'Auch bei Pflegegrad 1. Keine Barauszahlung — er wird mit anerkannten Angeboten verrechnet.',
  },
  {
    was: 'Pflegehilfsmittel zum Verbrauch',
    betrag: PFLEGEHILFSMITTEL_VERBRAUCH.betrag,
    takt: 'im Monat',
    quelle: PFLEGEHILFSMITTEL_VERBRAUCH.quelle,
    hinweis: 'Handschuhe, Desinfektion, Bettschutzeinlagen.',
  },
  {
    was: 'Wohnumfeld verbessern',
    betrag: WOHNUMFELDVERBESSERUNG.je_massnahme,
    takt: 'je Maßnahme',
    quelle: WOHNUMFELDVERBESSERUNG.quelle,
    hinweis: 'Etwa Treppenlift oder bodengleiche Dusche. Auch bei Pflegegrad 1.',
  },
  {
    was: 'Pflegeheim',
    betrag: grad === 1 ? VOLLSTATIONAER_GRAD_1.betrag : heim,
    takt: 'im Monat',
    quelle: grad === 1 ? VOLLSTATIONAER_GRAD_1.quelle : VOLLSTATIONAER.quelle,
    hinweis:
      grad === 1
        ? 'Nur ein Zuschuss — bei Pflegegrad 1 übernimmt die Pflegekasse die Pflegekosten im Heim nicht.'
        : 'Was die Pflegekasse zu den pflegebedingten Kosten beisteuert. Den Rest zahlen Sie selbst.',
  },
];

const geschwister = THEMEN.filter((t) => t.kategorie === 'pflegegrad' && t.slug !== `pflegegrad-${grad}`);

const titel = `Pflegegrad ${grad}: Geld und Leistungen 2026`;
const beschreibung = hatGeldleistung
  ? `Pflegegrad ${grad} 2026: ${euro(pflegegeld!)} Pflegegeld oder ${euro(sachleistung!)} Sachleistung im Monat, dazu Entlastungsbetrag und Verhinderungspflege — mit Rechner und Fundstelle.`
  : `Pflegegrad 1 2026: kein Pflegegeld, aber Entlastungsbetrag, Pflegehilfsmittel und Zuschüsse fürs Wohnumfeld — was Ihnen zusteht, mit Fundstelle zu jedem Betrag.`;
---

<BaseLayout title={titel} description={beschreibung} path={`/pflegegrad-${grad}/`}>
  <p style={`--accent: ${akzent}`} class="flex items-center gap-2 text-[14px] font-medium text-(--accent)">
    <Icon name="pflegegrad" class="h-5 w-5" />
    Pflegegrad
  </p>

  <h1 class="mt-3 font-display text-3xl text-ink sm:text-4xl">
    Pflegegrad {grad}: Geld und Leistungen
  </h1>

  <div class="mt-5">
    <PflegegradBadge grad={grad} />
  </div>

  {/* Der Leitbetrag als Ziffer, nicht im Fließtext (Überarbeitung 2026-08-15).
      Wer diese Seite aufruft, sucht eine Zahl; sie stand bisher mitten in
      einem Satz und war von der Erklärung daneben nicht zu unterscheiden. Sie
      steht im Farbpaar des Grades, damit dieselbe Farbe, die auf der
      Startseite den Grad markiert, hier den Betrag trägt — die Skala soll man
      einmal lernen und überall wiedererkennen. */}
  {
    hatGeldleistung && (
      <div
        class="mt-8 inline-block rounded-lg bg-(--pg-ground) px-8 py-6 text-(--pg-on)"
        style={`--pg-ground: var(--color-pflegegrad-${grad}); --pg-on: var(--color-pflegegrad-on-${grad});`}
      >
        <p class="text-[15px] opacity-80">Pflegegeld im Monat</p>
        <p class="mt-1 font-display text-[clamp(3rem,10vw,4.5rem)] leading-none font-semibold tracking-tight">
          {euro(pflegegeld!)}
        </p>
        <p class="mt-2 text-[14px] opacity-80">§ 37 Abs. 1 SGB XI</p>
      </div>
    )
  }

  {
    hatGeldleistung ? (
      <p class="mt-6 max-w-prose text-lg text-ink">
        Sie erhalten das Pflegegeld, wenn Sie die Pflege selbst organisieren — etwa mit
        Angehörigen. Wählen Sie stattdessen einen ambulanten Pflegedienst, zahlt die
        Kasse <strong>{euro(sachleistung!)}</strong> als Pflegesachleistung; beides lässt
        sich kombinieren. Dazu kommen {euro(ENTLASTUNGSBETRAG.betrag)} Entlastungsbetrag
        im Monat.
      </p>
    ) : (
      <p class="mt-6 max-w-prose text-lg text-ink">
        Bei Pflegegrad 1 gibt es <strong>kein Pflegegeld und keine Pflegesachleistung</strong>. Das
        ist die wichtigste Auskunft dieser Seite, und sie überrascht viele. Was Ihnen zusteht, ist
        trotzdem nicht nichts: {euro(ENTLASTUNGSBETRAG.betrag)} Entlastungsbetrag im Monat,{' '}
        {euro(PFLEGEHILFSMITTEL_VERBRAUCH.betrag)} für Pflegehilfsmittel und bis zu{' '}
        {euro(WOHNUMFELDVERBESSERUNG.je_massnahme)} je Umbaumaßnahme in der Wohnung.
      </p>
    )
  }

  <div class="mt-10">
    <AdSlot />
  </div>

  <h2 class="mt-12 font-display text-2xl text-ink">Alle Leistungen im Überblick</h2>
  <p class="mt-2 max-w-prose text-ink-soft">
    Jeder Betrag mit der Vorschrift, aus der er stammt. Stand: {datum(SGB_XI_STAND)}, Fassung des
    SGB XI: {SGB_XI_FASSUNG}.
  </p>

  <ul class="mt-6 flex list-none flex-col divide-y divide-rule border-y border-rule p-0">
    {
      zeilen.map((zeile) => (
        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
          <div class="min-w-0 flex-1 basis-64">
            <span class="block text-ink">{zeile.was}</span>
            {zeile.hinweis && (
              <span class="mt-0.5 block text-[15px] text-ink-mute">{zeile.hinweis}</span>
            )}
            <a
              href={zeile.quelle.url}
              rel="nofollow noopener"
              target="_blank"
              class="mt-1 inline-block text-[15px] text-ink-mute underline"
            >
              {zeile.quelle.fundstelle}
            </a>
          </div>
          <div class="text-right whitespace-nowrap">
            {zeile.betrag === null ? (
              <span class="font-display text-lg text-ink-mute">kein Anspruch</span>
            ) : (
              <>
                <span class="block font-display text-3xl leading-none tabular-nums text-ink">
                  {euro(zeile.betrag)}
                </span>
                <span class="mt-1 block text-[15px] text-ink-mute">{zeile.takt}</span>
              </>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  {
    hatGeldleistung && (
      <>
        <h2 class="mt-14 font-display text-2xl text-ink">
          Pflegegeld und Pflegedienst zusammen nutzen
        </h2>
        <p class="mt-2 max-w-prose text-ink-soft">
          Sie müssen sich nicht entscheiden. Nehmen Sie den Pflegedienst nur teilweise in Anspruch,
          bleibt Ihnen der Rest als anteiliges Pflegegeld. Schieben Sie den Regler, um zu sehen, was
          dabei herauskommt.
        </p>
        <div class="mt-5">
          <LeistungsRechner grad={grad} client:load />
        </div>
      </>
    )
  }

  <h2 class="mt-14 font-display text-2xl text-ink">Wo Pflegegrad {grad} auf der Skala liegt</h2>
  <p class="mt-2 max-w-prose text-ink-soft">
    Diese Farbskala bedeutet auf jeder Seite dieser Website dasselbe. Je dunkler, desto höher der
    Grad — und desto mehr Leistungen stehen zu.
  </p>
  <div class="mt-5">
    <PflegegradSkala aktiv={grad} />
  </div>

  <NaechsterSchritt akzent={akzent} />

  <h2 class="mt-14 font-display text-2xl text-ink">Andere Pflegegrade</h2>
  <ul class="mt-4 flex flex-col divide-y divide-rule border-y border-rule">
    {
      geschwister.map((thema) => (
        <li>
          <a
            href={pfadVon(thema)}
            style={`--accent: ${akzent}`}
            class="flex items-center gap-3 py-3 transition-colors hover:bg-(--accent)/5"
          >
            <Icon name="pfeil-rechts" class="h-5 w-5 shrink-0 text-(--accent)" />
            <span class="text-ink">{thema.titel}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-12">
    <AdSlot />
  </div>

  <div class="mt-10">
    <Disclaimer />
  </div>
</BaseLayout>
