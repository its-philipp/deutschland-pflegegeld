---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Disclaimer from '../components/Disclaimer.astro';
import NaechsterSchritt from '../components/NaechsterSchritt.astro';
import { accentFor } from '../data/kategorien';
import { SGB_XI_STAND } from '../data/leistungen';
import { jahrAus } from '../lib/jahr';

/**
 * Der Antragsweg als eigene Seite (2026-10-31).
 *
 * Der Block stand vorher auf acht Seiten zugleich und machte die
 * Pflegegrad-Seiten zu einem Drittel wortgleich. Hier steht er einmal, unter
 * der Frage, die Leute dazu stellen.
 */
const akzent = accentFor('antrag');
---

<BaseLayout
  title={`Pflegegrad beantragen ${jahrAus(SGB_XI_STAND)}: Antrag, Begutachtung, Fristen`}
  description="Pflegegrad beantragen: formlos bei der Pflegekasse, dann Begutachtung und Bescheid binnen 25 Arbeitstagen – mit allen Fristen aus dem SGB XI."
  path="/pflegegrad-beantragen/"
>
  <nav class="text-[14px] text-ink-mute" aria-label="Sie sind hier">
    <a href="/" class="underline underline-offset-2">Startseite</a> · Pflegegrad beantragen
  </nav>

  <h1 class="mt-3 font-display text-3xl text-ink sm:text-4xl">Pflegegrad beantragen</h1>

  <p class="mt-6 max-w-prose text-lg text-ink">
    Ein Anruf bei der Pflegekasse genügt, und ab dem Tag des Antrags laufen Fristen — für die
    Kasse, nicht für Sie. Wer sie kennt, wartet nicht länger als nötig und weiß, wann ihm Geld
    für die Verspätung zusteht.
  </p>

  <div class="mt-10">
    <AdSlot />
  </div>

  <NaechsterSchritt akzent={akzent} />

  <p class="mt-10 max-w-prose text-ink-soft">
    Was Sie mit welchem Grad bekommen, steht auf den Seiten zu
    <a class="text-ink underline" href="/pflegegrad-2/">Pflegegrad 2</a>,
    <a class="text-ink underline" href="/pflegegrad-3/">3</a>,
    <a class="text-ink underline" href="/pflegegrad-4/">4</a> und
    <a class="text-ink underline" href="/pflegegrad-5/">5</a>. Welcher Grad zu erwarten ist,
    lässt sich vorab mit der
    <a class="text-ink underline" href="/pflegegrad-berechnen/">Selbsteinschätzung</a> abschätzen.
  </p>

  <div class="mt-12">
    <AdSlot />
  </div>

  <div class="mt-10">
    <Disclaimer />
  </div>
</BaseLayout>
