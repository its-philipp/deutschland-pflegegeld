---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon from '../components/Icon.astro';
import { accentFor } from '../data/kategorien';
import {
  BUND,
  EIGENANTEIL_QUELLE,
  LAENDER,
  landSlug,
  rangErstesJahr,
  type LandEigenanteil,
} from '../data/eigenanteile';
import { jahrAus } from '../lib/jahr';

/**
 * "Pflegeheim Kosten «Bundesland»" — sixteen pages (queue task 2.7).
 *
 * The page exists because the number people are given ("ein Heimplatz kostet
 * 3.364 €") hides the two things that decide what they actually pay: which
 * Bundesland they are in, and how long they have been there. Both are in the
 * vdek data, so both are on the page.
 *
 * **The Leistungszuschlag is the trap this page is built around.** § 43c SGB XI
 * reduces only the EEE — the care share — and leaves Unterkunft, Verpflegung
 * and Investitionskosten untouched. Ratgeber routinely present it as a discount
 * on the whole bill, which overstates the relief by a wide margin. The
 * breakdown here shows the three parts separately, so the reader can see what
 * the percentage does and does not touch.
 */
export function getStaticPaths() {
  return LAENDER.map((land) => ({ params: { land: landSlug(land) }, props: { land } }));
}

interface Props {
  land: LandEigenanteil;
}

const { land } = Astro.props;
const akzent = accentFor('heim');
const rang = rangErstesJahr(land);

const euro = (b: number) =>
  b.toLocaleString('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
const datum = (iso: string) => iso.split('-').reverse().join('.');

const erstesJahr = land.eigenbeteiligung_mit_zuschuss.bis_12_monate;
const abweichung = erstesJahr - BUND.eigenbeteiligung_mit_zuschuss.bis_12_monate;

const stufen = [
  { label: 'im 1. Jahr', prozent: 15, zuschuss: land.zuschuss.bis_12_monate_15, zahlt: land.eigenbeteiligung_mit_zuschuss.bis_12_monate },
  { label: 'ab dem 2. Jahr', prozent: 30, zuschuss: land.zuschuss.ab_12_monate_30, zahlt: land.eigenbeteiligung_mit_zuschuss.ab_12_monate },
  { label: 'ab dem 3. Jahr', prozent: 50, zuschuss: land.zuschuss.ab_24_monate_50, zahlt: land.eigenbeteiligung_mit_zuschuss.ab_24_monate },
  { label: 'ab dem 4. Jahr', prozent: 75, zuschuss: land.zuschuss.ab_36_monate_75, zahlt: land.eigenbeteiligung_mit_zuschuss.ab_36_monate },
];

// Die Erklärung der drei Posten steht seit 2026-10-31 einmal auf
// `/pflegeheim-kosten/`; hier bleiben die Zahlen des Landes und der Vergleich
// zum Bund, der je Land verschieden ausfällt.
const bestandteile = [
  {
    was: 'Pflegekosten',
    betrag: land.eee_ohne_zuschuss,
    bund: BUND.eee_ohne_zuschuss,
    hinweis: `darin ${euro(land.davon_ausbildungskosten)} Ausbildungsumlage`,
  },
  {
    was: 'Unterkunft und Verpflegung',
    betrag: land.unterkunft_verpflegung,
    bund: BUND.unterkunft_verpflegung,
  },
  {
    was: 'Investitionskosten',
    betrag: land.investitionskosten,
    bund: BUND.investitionskosten,
  },
];

/**
 * Welcher der drei Posten das Land am weitesten vom Bund entfernt — der eine
 * Satz, der je Land wirklich verschieden ist und erklärt, *warum* es hier
 * teurer oder günstiger ist.
 */
const groessteAbweichung = [...bestandteile].sort(
  (a, b) => Math.abs(b.betrag - b.bund) - Math.abs(a.betrag - a.bund),
)[0]!;

/** Die zwei Länder davor und danach in der Rangfolge, statt aller fünfzehn. */
const rangfolge = [...LAENDER].sort(
  (a, b) => a.eigenbeteiligung_mit_zuschuss.bis_12_monate - b.eigenbeteiligung_mit_zuschuss.bis_12_monate,
);
const nachbarn = rangfolge
  .map((l, i) => ({ land: l, platz: i + 1 }))
  .filter(({ platz }) => Math.abs(platz - rang) <= 2);

/**
 * Titel und Description passen sich der Länge des Landesnamens an.
 *
 * Sechzehn Länder teilen sich eine Vorlage, und „Mecklenburg-Vorpommern" ist
 * neun Zeichen länger als „Bremen": 18 der 31 Descriptions lagen über 160
 * Zeichen, die längste bei 183, und ein Titel über 65. Google schneidet dann
 * mitten im Satz ab. Gekürzt wird deshalb in Stufen, und die Zahl — das
 * Einzige, weswegen jemand die Seite aufruft — bleibt in jeder davon stehen.
 */
const MAX_TITEL = 65;
const MAX_BESCHREIBUNG = 160;
const stand = datum(EIGENANTEIL_QUELLE.abgerufen);
/**
 * Gebraeuchliche Kurzform, aber nur wo nachweislich danach gesucht wird.
 * Gemessen am 2026-08-31: „pflegeheim kosten nrw" traegt eigenes Suchvolumen
 * (170, Difficulty 0), waehrend der ausgeschriebene Landesname in derselben
 * Anfrage nicht vorkommt. Weitere Laender erst aufnehmen, wenn ein Beleg
 * vorliegt — eine erfundene Abkuerzung kostet Titellaenge und bringt nichts.
 */
const KURZFORM: Record<string, string> = {
  'Nordrhein-Westfalen': 'NRW',
};
const kurz = KURZFORM[land.name];
/**
 * „in Hessen", aber „im Saarland" — das einzige Land mit Artikel. Bis 2026-09-14
 * stand fünfmal „in Saarland" auf der Seite, auch in der H1.
 */
const imLand = land.name === 'Saarland' ? 'im Saarland' : `in ${land.name}`;
// s. `lib/jahr.ts`: Der Titel trägt das Jahr der Erhebung, nicht das laufende.
const jahr = jahrAus(EIGENANTEIL_QUELLE.stand);
const titel =
  [
    ...(kurz ? [`Pflegeheim Kosten ${land.name} (${kurz}) ${jahr}: Eigenanteil`] : []),
    // Suchanfragen „kosten pflegeheim pflegegrad 4 hessen" u. ä. landeten 2026-08/09
    // in fünf Ländern auf Position 10–60 (GSC). Der Pflegegrad ist die Frage, und die
    // Antwort der Seite ist, dass der Eigenanteil für 2 bis 5 gleich ist.
    `Pflegeheim Kosten ${land.name} ${jahr}: Eigenanteil Pflegegrad 2–5`,
    `Pflegeheim Kosten ${land.name} ${jahr}: Eigenanteil im Monat`,
    `Pflegeheim Kosten ${land.name} ${jahr}: Eigenanteil`,
  ].find((t) => t.length <= MAX_TITEL) ?? `Pflegeheim Kosten ${land.name} ${jahr}`;
const beschreibung =
  [
    `Was ein Heimplatz ${imLand} selbst kostet: ${euro(erstesJahr)} im ersten Jahr – gleich für Pflegegrad 2 bis 5, mit den drei Kostenteilen und dem Leistungszuschlag. Stand ${stand}.`,
    `Heimplatz ${imLand}: ${euro(erstesJahr)} Eigenanteil im ersten Jahr – gleich für Pflegegrad 2 bis 5, mit Kostenteilen und Leistungszuschlag. Stand ${stand}.`,
    `Was ein Heimplatz ${imLand} selbst kostet: ${euro(erstesJahr)} im ersten Jahr, mit den drei Kostenteilen einzeln und dem Leistungszuschlag nach Aufenthaltsdauer. Stand ${stand}.`,
    `Was ein Heimplatz ${imLand} selbst kostet: ${euro(erstesJahr)} im ersten Jahr, mit den drei Kostenteilen und dem Leistungszuschlag. Stand ${stand}.`,
    `Was ein Heimplatz ${imLand} selbst kostet: ${euro(erstesJahr)} im ersten Jahr, aufgeschlüsselt nach Kostenteilen. Stand ${stand}.`,
  ].find((b) => b.length <= MAX_BESCHREIBUNG) ??
  `Eigenanteil für einen Heimplatz ${imLand}: ${euro(erstesJahr)} im ersten Jahr. Stand ${stand}.`;
---

<BaseLayout title={titel} description={beschreibung} path={`/pflegeheim-kosten-${landSlug(land)}/`}>
  <p style={`--accent: ${akzent}`} class="flex items-center gap-2 text-[14px] font-medium text-(--accent)">
    <Icon name="heim" class="h-5 w-5" />
    Pflegeheim & Eigenanteil
  </p>

  <h1 class="mt-3 font-display text-3xl text-ink sm:text-4xl">
    Was kostet ein Pflegeheim {imLand}?
  </h1>

  <p class="mt-6 max-w-prose text-lg text-ink">
    Im ersten Jahr zahlen Bewohnerinnen und Bewohner {imLand} durchschnittlich{' '}
    <strong>{euro(erstesJahr)} im Monat</strong> aus eigener Tasche. Das sind{' '}
    {abweichung === 0
      ? 'genau so viel wie im Bundesdurchschnitt'
      : `${euro(Math.abs(abweichung))} ${abweichung > 0 ? 'mehr' : 'weniger'} als im Bundesdurchschnitt`}{' '}
    ({euro(BUND.eigenbeteiligung_mit_zuschuss.bis_12_monate)}). Unter den 16 Bundesländern liegt{' '}
    {land.name} damit auf Platz {rang} von 16 — Platz 1 ist am günstigsten.
  </p>

  <p class="mt-4 max-w-prose text-ink-soft">
    Je länger jemand im Heim lebt, desto weniger wird es: {euro(land.eigenbeteiligung_mit_zuschuss.ab_36_monate)}{' '}
    ab dem vierten Jahr. Warum das so ist, steht weiter unten.
  </p>

  <div class="mt-10">
    <AdSlot />
  </div>

  <h2 class="mt-12 font-display text-2xl text-ink">Die drei Kostenteile {imLand}</h2>
  <p class="mt-2 max-w-prose text-ink-soft">
    Am weitesten vom Bundesdurchschnitt entfernt sind {imLand} die{' '}
    <strong class="text-ink">{groessteAbweichung.was}</strong>:{' '}
    {euro(groessteAbweichung.betrag)} statt {euro(groessteAbweichung.bund)}
    {groessteAbweichung.betrag === groessteAbweichung.bund
      ? '.'
      : `, also ${euro(Math.abs(groessteAbweichung.betrag - groessteAbweichung.bund))} ${groessteAbweichung.betrag > groessteAbweichung.bund ? 'mehr' : 'weniger'}.`}{' '}
    Was die drei Posten bedeuten und welcher davon durch den Zuschlag sinkt, steht in der{' '}
    <a href="/pflegeheim-kosten/" class="text-ink underline">Übersicht aller Länder</a>.
  </p>

  <div class="mt-5 overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b-2 border-ink">
          <th scope="col" class="py-2 pr-3 font-display font-semibold">Posten</th>
          <th scope="col" class="py-2 pr-3 text-right font-display font-semibold">{land.name}</th>
          <th scope="col" class="py-2 text-right font-display font-semibold">Bund</th>
        </tr>
      </thead>
      <tbody>
        {
          bestandteile.map((b) => (
            <tr class="border-b border-rule align-baseline">
              <th scope="row" class="py-3 pr-3 text-left font-normal">
                <span class="block text-ink">{b.was}</span>
                {b.hinweis && <span class="mt-0.5 block text-[15px] text-ink-mute">{b.hinweis}</span>}
              </th>
              <td class="py-3 pr-3 text-right font-display text-lg tabular-nums whitespace-nowrap text-ink">
                {euro(b.betrag)}
              </td>
              <td class="py-3 text-right font-display tabular-nums whitespace-nowrap text-ink-soft">
                {euro(b.bund)}
              </td>
            </tr>
          ))
        }
        <tr class="align-baseline">
          <th scope="row" class="py-3 pr-3 text-left font-semibold text-ink">
            Zusammen, vor dem Zuschlag
          </th>
          <td class="py-3 pr-3 text-right font-display text-xl tabular-nums whitespace-nowrap text-ink">
            {euro(land.eigenbeteiligung_ohne_zuschuss)}
          </td>
          <td class="py-3 text-right font-display tabular-nums whitespace-nowrap text-ink-soft">
            {euro(BUND.eigenbeteiligung_ohne_zuschuss)}
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  {/* Ergaenzt am 2026-08-31 aus den eigenen Suchdaten. „kosten pflegeheim
      pflegegrad 4 niedersachsen" steht auf Position 7 — die Leute suchen also
      mit dem Pflegegrad im Kopf. Die Seite trug den Fachbegriff
      „einrichtungseinheitlich" genau einmal in einer Tabellenzeile und sagte
      nirgends, was er bedeutet: dass der Pflegegrad fuer diesen Betrag keine
      Rolle spielt. Das ist die Antwort auf die gestellte Frage und zugleich
      eine ueberraschende — wer einen hoeheren Grad bekommt, erwartet eine
      hoehere Rechnung.

      Bewusst KEINE eigene Seite je Pflegegrad: Nach § 84 Abs. 2 Satz 3 SGB XI
      ist der Eigenanteil fuer die Grade 2 bis 5 derselbe. 16 Laender x 4 Grade
      waeren 64 Seiten mit identischer Zahl — genau die duenne Masse, fuer die
      Google deutschland-vorlagen abgelehnt hat. */}
  <p class="mt-6 max-w-prose text-ink-soft">
    <strong class="text-ink">Mit Pflegegrad 2, 3, 4 oder 5</strong> zahlen Sie {imLand} denselben
    Betrag: Der Eigenanteil an den Pflegekosten ist innerhalb eines Heims für alle Grade gleich
    (§ 84 Abs. 2 Satz 3 SGB XI).{' '}
    <a href="/pflegeheim-kosten/" class="text-ink underline">Warum das so ist</a>.
  </p>

  <h2 class="mt-14 font-display text-2xl text-ink">Was ein Platz {imLand} nach Aufenthaltsdauer kostet</h2>
  <p class="mt-2 max-w-prose text-ink-soft">
    Der Zuschlag der Pflegekasse nach § 43c SGB XI wächst mit jedem Jahr im Heim, mindert aber nur
    die Pflegekosten von {euro(land.eee_ohne_zuschuss)}.
  </p>

  <div class="mt-5 overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b-2 border-ink">
          <th scope="col" class="py-2 pr-3 font-display font-semibold">Aufenthalt</th>
          <th scope="col" class="py-2 pr-3 text-right font-display font-semibold">Zuschlag</th>
          <th scope="col" class="py-2 text-right font-display font-semibold">Sie zahlen</th>
        </tr>
      </thead>
      <tbody>
        {
          stufen.map((s) => (
            <tr class="border-b border-rule align-baseline">
              <th scope="row" class="py-3 pr-3 text-left font-normal text-ink">
                {s.label}
                <span class="mt-0.5 block text-[15px] text-ink-mute">
                  {s.prozent} % der Pflegekosten
                </span>
              </th>
              <td class="py-3 pr-3 text-right font-display tabular-nums whitespace-nowrap text-ink-soft">
                − {euro(s.zuschuss)}
              </td>
              <td class="py-3 text-right font-display text-lg tabular-nums whitespace-nowrap text-ink">
                {euro(s.zahlt)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {/* LANDESTEIL: hier kommen die landesspezifischen Abschnitte hin. */}

  <h2 class="mt-14 font-display text-2xl text-ink">{land.name} zwischen seinen Nachbarn im Ranking</h2>
  <ul class="mt-4 flex flex-col divide-y divide-rule border-y border-rule">
    {
      nachbarn.map(({ land: l, platz }) => (
        <li>
          {l.code === land.code ? (
            <span class="flex items-center gap-3 py-3 font-semibold">
              <span class="w-8 text-right tabular-nums text-ink-mute">{platz}.</span>
              <span class="min-w-0 flex-1 text-ink">{l.name}</span>
              <span class="font-display tabular-nums text-ink">
                {euro(l.eigenbeteiligung_mit_zuschuss.bis_12_monate)}
              </span>
            </span>
          ) : (
            <a
              href={`/pflegeheim-kosten-${landSlug(l)}/`}
              style={`--accent: ${akzent}`}
              class="flex items-center gap-3 py-3 transition-colors hover:bg-(--accent)/5"
            >
              <span class="w-8 text-right tabular-nums text-ink-mute">{platz}.</span>
              <span class="min-w-0 flex-1 text-ink underline underline-offset-2">{l.name}</span>
              <span class="font-display tabular-nums text-ink-soft">
                {euro(l.eigenbeteiligung_mit_zuschuss.bis_12_monate)}
              </span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
  <p class="mt-3 text-ink-soft">
    <a href="/pflegeheim-kosten/" class="text-ink underline">Alle 16 Länder im Vergleich</a>
  </p>

  <p class="mt-10 text-[14px] text-ink-mute">
    Quelle: {EIGENANTEIL_QUELLE.herausgeber}, Stand {EIGENANTEIL_QUELLE.stand}, abgerufen am{' '}
    {datum(EIGENANTEIL_QUELLE.abgerufen)}. Durchschnittswerte; einzelne Heime weichen ab.{' '}
    <a href={EIGENANTEIL_QUELLE.pressemitteilung} rel="nofollow noopener" target="_blank" class="underline">
      Zur Quelle
    </a>{' '}
    ·{' '}
    <a class="underline" href="/eigenanteile-bundeslaender.csv">alle Länder als CSV</a>
  </p>

  <div class="mt-12">
    <AdSlot />
  </div>

  <div class="mt-10">
    <Disclaimer />
  </div>
</BaseLayout>
