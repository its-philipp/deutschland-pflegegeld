---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  CONTACT_EMAIL,
  IMPRESSUM_NAME,
  IMPRESSUM_ADDRESS,
} from '../lib/site';

/**
 * Impressum per § 5 DDG (the successor to § 5 TMG) and § 18 Abs. 2 MStV for
 * the journalistic-editorial content.
 *
 * `noindex`: a legal notice competes for nothing and only dilutes the site's
 * indexed surface. It stays reachable from the footer and out of the sitemap.
 *
 * The identity fields are `{{IMPRESSUM_*}}` placeholders on purpose — see
 * lib/site.ts. Never fill them with plausible-looking values.
 */
---

<BaseLayout
  title={`Impressum — ${SITE_NAME}`}
  description="Anbieterkennzeichnung nach § 5 DDG und § 18 Abs. 2 MStV."
  path="/impressum/"
  noindex
>
  <h1 class="font-display text-3xl font-semibold">Impressum</h1>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Angaben gemäß § 5 DDG</h2>
    <p class="mt-3 whitespace-pre-line">{`${IMPRESSUM_NAME}\n${IMPRESSUM_ADDRESS}`}</p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Kontakt</h2>
    <p class="mt-3">
      E-Mail: <a class="underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">
      Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
    </h2>
    <p class="mt-3 whitespace-pre-line">{`${IMPRESSUM_NAME}\n${IMPRESSUM_ADDRESS}`}</p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Streitschlichtung</h2>
    <p class="mt-3">
      Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren
      vor einer Verbraucherschlichtungsstelle teilzunehmen.
    </p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Haftung für Inhalte</h2>
    <p class="mt-3">
      Die Inhalte dieser Seite sind allgemeine Informationen zur
      Pflegeversicherung. Sie sind keine Rechtsberatung und keine Beratung durch
      die Pflegekasse. Über Pflegegrad und Leistungen entscheidet die
      Pflegekasse; für Ihren Einzelfall ist die kostenlose Pflegeberatung nach
      § 7a SGB XI zuständig.
    </p>
    <p class="mt-3">
      Wir erstellen die Inhalte sorgfältig und nennen zu jedem Betrag die Quelle
      und den Stand. Für Richtigkeit, Vollständigkeit und Aktualität können wir
      keine Gewähr übernehmen; maßgeblich ist die jeweils geltende Fassung der
      genannten Rechtsgrundlage.
    </p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Haftung für Links</h2>
    <p class="mt-3">
      Für die Inhalte verlinkter externer Seiten sind deren Betreiber
      verantwortlich. Zum Zeitpunkt der Verlinkung waren keine Rechtsverstöße
      erkennbar.
    </p>
  </section>

  {/* Owner-Entscheidung 2026-08-15, portfolioweit: KI-Beteiligung offenlegen,
      statt zu warten, bis sie jemand bemerkt. */}
  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Einsatz von KI</h2>
    <p class="mt-3">
      Die Texte dieser Website entstehen unter redaktioneller Verantwortung des
      oben genannten Anbieters mit Unterstützung von KI-Systemen. Die
      Leistungsbeträge werden nicht frei formuliert, sondern aus den Vorschriften
      des SGB XI und den benannten Erhebungen übernommen; jede Angabe nennt ihre
      Fundstelle und den Stand.
    </p>
  </section>

  <section class="mt-8 max-w-prose">
    <h2 class="font-display text-xl font-semibold">Urheberrecht</h2>
    <p class="mt-3">
      Die von uns erstellten Inhalte unterliegen dem deutschen Urheberrecht.
      Gesetzestexte und amtliche Werke sind nach § 5 UrhG gemeinfrei.
    </p>
  </section>
</BaseLayout>
